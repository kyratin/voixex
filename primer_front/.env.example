# --- Bundled into the static export at build time (NEXT_PUBLIC_*) ---

# Full API URL — optional. If set, host/port/TLS are derived unless overridden below.
# Example: https://kyratin.ru:18080
NEXT_PUBLIC_API_BASE=

# Defaults when connecting in the desktop app (can still be changed in UI).
NEXT_PUBLIC_DEFAULT_API_HOST=localhost
NEXT_PUBLIC_DEFAULT_API_PORT=18080
# true | false — if unset, TLS is inferred from NEXT_PUBLIC_API_BASE when possible
NEXT_PUBLIC_DEFAULT_USE_HTTPS=false

# Server password shown as default in the connect panel (not secret at build time; anyone can read exported JS).
NEXT_PUBLIC_DEFAULT_SERVER_PASSWORD=1234

# Optional: force voice UDP to this port (same as in-app "Voice UDP port"); empty = use server join response.
NEXT_PUBLIC_DEFAULT_UDP_PORT=
