{
  "name": "voip-desktop-client",
  "version": "0.6.3",
  "description": "Desktop VoIP client shell",
  "author": {
    "name": "kyratin",
    "email": "kyratin@example.com"
  },
  "homepage": "https://github.com/kyratin/voixex",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare:ui": "node ./scripts/sync-ui.mjs",
    "start": "electron ./dist/main.js",
    "pack": "electron-builder --dir",
    "dist": "bash ./scripts/dist-release.sh",
    "dist:current": "npm run build && npm run prepare:ui && electron-builder --publish never",
    "dist:win": "npm run build && npm run prepare:ui && electron-builder --win nsis --x64 --publish never",
    "dist:win:only": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && npm run prepare:ui && electron-builder --linux AppImage deb --publish never",
    "dist:mac": "npm run build && npm run prepare:ui && electron-builder --mac dmg --publish never",
    "dist:mac:zip": "npm run build && npm run prepare:ui && electron-builder --mac zip --publish never",
    "dist:docker": "bash ./scripts/docker-electron-build.sh",
    "dist:docker:only": "bash ./scripts/docker-electron-build.sh --skip-prepare"
  },
  "dependencies": {
    "opusscript": "^0.1.1",
    "voip-voice-client": "file:../voice-client"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.voixex.desktop",
    "productName": "Voixex",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "icon": "build/icons/icon-1024.png",
    "files": [
      "dist/**/*",
      "preload.cjs",
      "ui/**/*",
      "build/icons/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icons/icon.icns",
        "to": "icon.icns"
      },
      {
        "from": "build/icons/icon-512.png",
        "to": "icon-512.png"
      }
    ],
    "linux": {
      "maintainer": "kyratin <kyratin@example.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons/icon-512.png",
      "category": "Network"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Voixex uses the microphone for voice chat in channels.",
        "NSScreenCaptureUsageDescription": "Voixex needs screen capture permission to share your display with others."
      }
    },
    "dmg": {
      "backgroundColor": "#111111",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico"
    }
  }
}
