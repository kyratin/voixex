{
  "name": "voip-desktop-client",
  "version": "0.1.2",
  "description": "Desktop VoIP client shell",
  "author": {
    "name": "kyratin",
    "email": "kyratin@example.com"
  },
  "homepage": "https://example.com/voip-desktop-client",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare:ui": "node ./scripts/sync-ui.mjs",
    "start": "electron ./dist/main.js",
    "pack": "electron-builder --dir",
    "dist": "npm run prepare:ui && electron-builder",
    "dist:win": "npm run prepare:ui && electron-builder --win nsis",
    "dist:linux": "npm run prepare:ui && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "voip-voice-client": "file:../voice-client"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.voixex.desktop",
    "productName": "Voixex",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "preload.cjs",
      "ui/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "linux": {
      "maintainer": "kyratin <kyratin@example.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
