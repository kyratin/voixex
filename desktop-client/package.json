{
  "name": "voip-desktop-client",
  "version": "0.2.10",
  "description": "Desktop VoIP client shell",
  "author": {
    "name": "kyratin",
    "email": "kyratin@example.com"
  },
  "homepage": "https://example.com/voip-desktop-client",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare:ui": "node ./scripts/sync-ui.mjs",
    "start": "electron ./dist/main.js",
    "pack": "electron-builder --dir",
    "dist": "npm run prepare:ui && electron-builder",
    "dist:win": "npm run prepare:ui && electron-builder --win nsis",
    "dist:linux": "npm run prepare:ui && electron-builder --linux AppImage deb",
    "dist:mac": "npm run prepare:ui && electron-builder --mac dmg",
    "dist:mac:zip": "npm run prepare:ui && electron-builder --mac zip",
    "dist:docker": "bash ./scripts/docker-electron-build.sh",
    "dist:docker:only": "bash ./scripts/docker-electron-build.sh --skip-prepare"
  },
  "dependencies": {
    "voip-voice-client": "file:../voice-client"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.voixex.desktop",
    "productName": "Voixex",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "preload.cjs",
      "ui/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "linux": {
      "maintainer": "kyratin <kyratin@example.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Voixex uses the microphone for voice chat in channels.",
        "NSScreenCaptureUsageDescription": "Voixex needs screen capture permission to share your display with others."
      }
    },
    "dmg": {
      "backgroundColor": "#111111",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
