# --- Docker Compose (this branch has backend only) ---
VOIP_BACKEND_IMAGE=kyratinkokko/voixex:latest

HTTP_PORT=18080
UDP_PORT=50000

# Required on a VPS: public IP or DNS — clients use this for UDP voice.
PUBLIC_UDP_HOST=your.server.example

TOKEN_SECRET=change-me-token-secret
SUPERUSER_PASSWORD=change-me-superuser

# Optional tuning (defaults are usually fine)
# MEDIA_RATE_LIMIT_PER_SEC=6000
# UPLOAD_MAX_MB=50
# SCREEN_LOG=0
