# --- Backend (docker compose: service `backend`) ---
# VOIP_BACKEND_IMAGE=kyratinkokko/voixex:latest
HTTP_PORT=18080
UDP_PORT=50000
# Required on a VPS: public IP or DNS so voice clients open UDP to the right host.
PUBLIC_UDP_HOST=your.server.example
TOKEN_SECRET=change-me-token-secret
SUPERUSER_PASSWORD=change-me-superuser

# --- Optional UI profile (`docker compose --profile ui up`) ---
NEXT_PUBLIC_API_BASE=http://localhost:18080
