# HTTP API + WebSocket (mapped host port -> container PORT, default 8080)
HTTP_PORT=18080
UDP_PORT=50000

# Hostname/IP clients use for UDP voice (must be reachable from user networks)
PUBLIC_UDP_HOST=localhost

# Required in production
TOKEN_SECRET=change-me-long-random-secret
SUPERUSER_PASSWORD=change-me-superuser

# ---------------------------------------------------------------------------
# TLS (HTTPS + WSS) — optional
# When enabled, the backend serves TLS on the same PORT inside the container
# (map host 443 -> 8080 or keep HTTP_PORT e.g. 18081 -> 8080).
# ---------------------------------------------------------------------------
# TLS_ENABLED=true
# TLS_CERT_PATH=/certs/fullchain.pem
# TLS_KEY_PATH=/certs/privkey.pem
#
# Mount PEMs into the container, e.g. in docker-compose.yml:
#   volumes:
#     - voixex-data:/data
#     - /etc/letsencrypt/live/your.domain/fullchain.pem:/certs/fullchain.pem:ro
#     - /etc/letsencrypt/live/your.domain/privkey.pem:/certs/privkey.pem:ro
# Or mount a folder:
#     - /etc/letsencrypt:/certs:ro
# and set TLS_CERT_PATH=/certs/live/your.domain/fullchain.pem
#     TLS_KEY_PATH=/certs/live/your.domain/privkey.pem
#
# Aliases: HTTPS=true (same as TLS_ENABLED)

# ---------------------------------------------------------------------------
# LiveKit (WebRTC voice / screen share) — runs inside the image by default
# ---------------------------------------------------------------------------
# URL clients use for LiveKit signalling. Default: ws://$PUBLIC_UDP_HOST:7880
# Behind HTTPS, proxy /livekit -> container port 7880 and set e.g.:
# LIVEKIT_PUBLIC_URL=wss://your.domain/livekit
#
# Public IP announced for WebRTC media (open 7881/tcp and 7882/udp to it).
# Default: discovered via STUN, which is wrong behind NAT / load balancers.
# LIVEKIT_NODE_IP=203.0.113.10
#
# API key defaults to "voixex"; the secret is generated once into /data/livekit-api-secret.
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
#
# External SFU instead of the embedded one: set LIVEKIT_URL, LIVEKIT_API_KEY and LIVEKIT_API_SECRET.
# Disable the embedded SFU entirely: LIVEKIT_EMBEDDED=false
